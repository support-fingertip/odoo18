<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_ticket_developer" model="res.groups">
        <field name="name">Developer</field>
        <field name="category_id" ref="base.module_category_services_project"/>
        <field name="comment">Developer can view tickets assigned to them</field>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
    </record>

    <record id="group_ticket_test_engineer" model="res.groups">
        <field name="name">Test Engineer</field>
        <field name="category_id" ref="base.module_category_services_project"/>
        <field name="comment">Test Engineer can create/edit test cases, scenarios, tickets</field>
        <field name="implied_ids" eval="[(4, ref('group_ticket_developer'))]"/>
    </record>

    <record id="group_ticket_qa_manager" model="res.groups">
        <field name="name">QA Manager</field>
        <field name="category_id" ref="base.module_category_services_project"/>
        <field name="comment">QA Manager has full access to all models</field>
        <field name="implied_ids" eval="[(4, ref('group_ticket_test_engineer'))]"/>
    </record>

</odoo>
