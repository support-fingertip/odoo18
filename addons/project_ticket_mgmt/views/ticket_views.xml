<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Ticket Kanban View -->
    <record id="view_project_ticket_kanban" model="ir.ui.view">
        <field name="name">project.ticket.kanban</field>
        <field name="model">project.ticket</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="color"/>
                <field name="severity"/>
                <field name="priority"/>
                <field name="reporter_id"/>
                <field name="assigned_to_id"/>
                <field name="project_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_color_#{kanban_getcolor(record.color.raw_value)} oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>: <field name="title"/>
                                        </strong>
                                    </div>
                                    <div class="o_dropdown_kanban dropdown">
                                        <a class="dropdown-toggle o-no-caret btn" role="button" data-toggle="dropdown" data-display="static" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                            <span class="fa fa-ellipsis-v"/>
                                        </a>
                                        <div class="dropdown-menu" role="menu">
                                            <a role="menuitem" type="edit" class="dropdown-item">Edit</a>
                                            <a role="menuitem" type="delete" class="dropdown-item">Delete</a>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="project_id"/>
                                    <div>
                                        <t t-if="record.severity.raw_value == 'blocker'">
                                            <span class="badge badge-danger"><field name="severity"/></span>
                                        </t>
                                        <t t-elif="record.severity.raw_value == 'critical'">
                                            <span class="badge badge-warning"><field name="severity"/></span>
                                        </t>
                                        <t t-elif="record.severity.raw_value == 'major'">
                                            <span class="badge badge-info"><field name="severity"/></span>
                                        </t>
                                        <t t-else="">
                                            <span class="badge badge-secondary"><field name="severity"/></span>
                                        </t>
                                        <span class="badge badge-secondary ml-1">
                                            <field name="priority"/>
                                        </span>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="reporter_id" widget="many2one_avatar_user"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="assigned_to_id" widget="many2one_avatar_user"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Ticket Form View -->
    <record id="view_project_ticket_form" model="ir.ui.view">
        <field name="name">project.ticket.form</field>
        <field name="model">project.ticket</field>
        <field name="arch" type="xml">
            <form string="Ticket">
                <header>
                    <button name="action_start_progress" string="Start Progress" type="object"
                            invisible="state != 'open'" class="oe_highlight"/>
                    <button name="action_mark_fixed" string="Mark as Fixed" type="object"
                            invisible="state not in ['open', 'in_progress', 'reopened']" class="oe_highlight"/>
                    <button name="action_close" string="Close" type="object"
                            invisible="state not in ['fixed']" class="oe_highlight"/>
                    <button name="action_reopen" string="Reopen" type="object"
                            invisible="state not in ['closed', 'fixed']"/>
                    <button name="action_defer" string="Defer" type="object"
                            invisible="state in ['closed', 'deferred']"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,in_progress,fixed,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="title" required="1" placeholder="Brief summary of the issue..."/>
                            <field name="project_id" required="1"/>
                            <field name="task_id"/>
                        </group>
                        <group>
                            <field name="severity"/>
                            <field name="priority"/>
                            <field name="environment"/>
                            <field name="device"/>
                            <field name="reproducibility"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="reporter_id"/>
                            <field name="reported_date"/>
                        </group>
                        <group>
                            <field name="assigned_to_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <separator string="Description"/>
                            <field name="description" nolabel="1" placeholder="What's wrong and what you expected..."/>
                            <separator string="Steps to Reproduce"/>
                            <field name="steps_to_reproduce" nolabel="1" placeholder="Numbered steps (exact clicks/inputs)..."/>
                        </page>
                        <page string="Results">
                            <separator string="Expected Result"/>
                            <field name="expected_result" nolabel="1"/>
                            <separator string="Actual Result"/>
                            <field name="actual_result" nolabel="1"/>
                        </page>
                        <page string="Evidence">
                            <field name="evidence_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Resolution">
                            <separator string="Resolution Notes"/>
                            <field name="resolution" nolabel="1"/>
                            <group>
                                <group>
                                    <field name="fixed_by_id"/>
                                    <field name="fixed_date"/>
                                </group>
                                <group>
                                    <field name="verified_by_id"/>
                                    <field name="verified_date"/>
                                </group>
                            </group>
                        </page>
                        <page string="Related">
                            <group>
                                <field name="test_plan_id"/>
                                <field name="test_case_id"/>
                            </group>
                            <separator string="Tags"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Ticket Tree View -->
    <record id="view_project_ticket_tree" model="ir.ui.view">
        <field name="name">project.ticket.tree</field>
        <field name="model">project.ticket</field>
        <field name="arch" type="xml">
            <tree string="Tickets">
                <field name="name"/>
                <field name="title"/>
                <field name="project_id"/>
                <field name="severity"/>
                <field name="priority"/>
                <field name="state"/>
                <field name="reporter_id"/>
                <field name="assigned_to_id"/>
                <field name="reported_date"/>
            </tree>
        </field>
    </record>

    <!-- Ticket Search View -->
    <record id="view_project_ticket_search" model="ir.ui.view">
        <field name="name">project.ticket.search</field>
        <field name="model">project.ticket</field>
        <field name="arch" type="xml">
            <search string="Tickets">
                <field name="name"/>
                <field name="title"/>
                <field name="project_id"/>
                <field name="reporter_id"/>
                <field name="assigned_to_id"/>
                <filter string="Open" name="open" domain="[('state', '=', 'open')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Fixed" name="fixed" domain="[('state', '=', 'fixed')]"/>
                <filter string="Closed" name="closed" domain="[('state', '=', 'closed')]"/>
                <filter string="Re-opened" name="reopened" domain="[('state', '=', 'reopened')]"/>
                <separator/>
                <filter string="Blocker" name="blocker" domain="[('severity', '=', 'blocker')]"/>
                <filter string="Critical" name="critical" domain="[('severity', '=', 'critical')]"/>
                <separator/>
                <filter string="P0" name="p0" domain="[('priority', '=', 'p0')]"/>
                <filter string="P1" name="p1" domain="[('priority', '=', 'p1')]"/>
                <separator/>
                <filter string="My Tickets" name="my_tickets" domain="[('assigned_to_id', '=', uid)]"/>
                <filter string="Reported by Me" name="reported_by_me" domain="[('reporter_id', '=', uid)]"/>
                <filter string="Unassigned" name="unassigned" domain="[('assigned_to_id', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Severity" name="group_severity" context="{'group_by': 'severity'}"/>
                    <filter string="Priority" name="group_priority" context="{'group_by': 'priority'}"/>
                    <filter string="Assigned To" name="group_assigned" context="{'group_by': 'assigned_to_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Ticket Pivot View -->
    <record id="view_project_ticket_pivot" model="ir.ui.view">
        <field name="name">project.ticket.pivot</field>
        <field name="model">project.ticket</field>
        <field name="arch" type="xml">
            <pivot string="Ticket Analysis">
                <field name="project_id" type="row"/>
                <field name="severity" type="col"/>
            </pivot>
        </field>
    </record>

    <!-- Ticket Action -->
    <record id="action_project_ticket" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="res_model">project.ticket</field>
        <field name="view_mode">kanban,tree,form,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first ticket
            </p>
        </field>
    </record>

</odoo>
