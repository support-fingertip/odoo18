<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Test Scenario Form View -->
    <record id="view_project_test_scenario_form" model="ir.ui.view">
        <field name="name">project.test.scenario.form</field>
        <field name="model">project.test.scenario</field>
        <field name="arch" type="xml">
            <form string="Test Scenario">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="draft,pass,fail"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id" required="1"/>
                            <field name="test_plan_id"/>
                            <field name="module"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="created_by_id" readonly="1"/>
                            <field name="reviewed_by_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <separator string="Description"/>
                            <field name="description" nolabel="1"/>
                            <separator string="Comments"/>
                            <field name="comments" nolabel="1"/>
                        </page>
                        <page string="Test Cases">
                            <field name="test_case_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="test_case_title"/>
                                    <field name="status"/>
                                    <field name="severity"/>
                                    <field name="test_type"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Test Scenario Tree View -->
    <record id="view_project_test_scenario_tree" model="ir.ui.view">
        <field name="name">project.test.scenario.tree</field>
        <field name="model">project.test.scenario</field>
        <field name="arch" type="xml">
            <tree string="Test Scenarios">
                <field name="name"/>
                <field name="date"/>
                <field name="module"/>
                <field name="project_id"/>
                <field name="status"/>
                <field name="created_by_id"/>
                <field name="reviewed_by_id"/>
            </tree>
        </field>
    </record>

    <!-- Test Scenario Search View -->
    <record id="view_project_test_scenario_search" model="ir.ui.view">
        <field name="name">project.test.scenario.search</field>
        <field name="model">project.test.scenario</field>
        <field name="arch" type="xml">
            <search string="Test Scenarios">
                <field name="name"/>
                <field name="module"/>
                <field name="project_id"/>
                <filter string="Draft" name="draft" domain="[('status', '=', 'draft')]"/>
                <filter string="Pass" name="pass" domain="[('status', '=', 'pass')]"/>
                <filter string="Fail" name="fail" domain="[('status', '=', 'fail')]"/>
                <filter string="Invalid" name="invalid" domain="[('status', '=', 'invalid')]"/>
                <group expand="0" string="Group By">
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Module" name="group_module" context="{'group_by': 'module'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Test Scenario Action -->
    <record id="action_project_test_scenario" model="ir.actions.act_window">
        <field name="name">Test Scenarios</field>
        <field name="res_model">project.test.scenario</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first test scenario
            </p>
        </field>
    </record>

</odoo>
