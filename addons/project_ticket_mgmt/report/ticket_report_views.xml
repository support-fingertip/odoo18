<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Ticket Report Pivot View -->
    <record id="view_project_ticket_report_pivot" model="ir.ui.view">
        <field name="name">project.ticket.report.pivot</field>
        <field name="model">project.ticket.report</field>
        <field name="arch" type="xml">
            <pivot string="Ticket Analysis">
                <field name="project_id" type="row"/>
                <field name="severity" type="col"/>
                <field name="ticket_count" type="measure"/>
                <field name="days_to_fix" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Ticket Report Graph View -->
    <record id="view_project_ticket_report_graph" model="ir.ui.view">
        <field name="name">project.ticket.report.graph</field>
        <field name="model">project.ticket.report</field>
        <field name="arch" type="xml">
            <graph string="Ticket Analysis">
                <field name="project_id"/>
                <field name="ticket_count" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Ticket Report Search View -->
    <record id="view_project_ticket_report_search" model="ir.ui.view">
        <field name="name">project.ticket.report.search</field>
        <field name="model">project.ticket.report</field>
        <field name="arch" type="xml">
            <search string="Ticket Analysis">
                <field name="project_id"/>
                <field name="severity"/>
                <field name="priority"/>
                <field name="state"/>
                <field name="reporter_id"/>
                <field name="assigned_to_id"/>
                <filter string="Open" name="open" domain="[('state', '=', 'open')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Fixed" name="fixed" domain="[('state', '=', 'fixed')]"/>
                <filter string="Closed" name="closed" domain="[('state', '=', 'closed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Severity" name="group_severity" context="{'group_by': 'severity'}"/>
                    <filter string="Priority" name="group_priority" context="{'group_by': 'priority'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Environment" name="group_environment" context="{'group_by': 'environment'}"/>
                    <filter string="Reporter" name="group_reporter" context="{'group_by': 'reporter_id'}"/>
                    <filter string="Assigned To" name="group_assigned" context="{'group_by': 'assigned_to_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Ticket Report Action -->
    <record id="action_project_ticket_report" model="ir.actions.act_window">
        <field name="name">Ticket Analysis</field>
        <field name="res_model">project.ticket.report</field>
        <field name="view_mode">pivot,graph</field>
        <field name="context">{'search_default_group_project': 1}</field>
    </record>

</odoo>
